{
  "manifest_version": 3,
  "name": "Arel Focus Tab Tracker",
  "description": "Sends active Chrome tab metadata to the local Arel Focus app.",
  "version": "0.2.0",
  "permissions": ["tabs", "nativeMessaging", "alarms", "favicon", "storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Arel Focus"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
